{
  "schema_version": "1.1",
  "dataset_name": "Lumbar_Spine_Segmentation",
  "description": "Lumbar_Spine_Segmentation: lumbar_vertebrae_and_intervertebral_disc_segmentation (segmentation, MRI, 3D)。样本 0-19 取 random.txt 顺序前 20 个 case，source_stem 由 9 模型多数票确定。",
  "expected_count": 20,
  "modality_primary": "MRI",
  "metrics": [
    "source_selection_accuracy",
    "coverage",
    "schema_validity",
    "semantic",
    "information_quality",
    "content_fidelity",
    "dataset_metadata_quality"
  ],
  "evaluation_protocol": {
    "instance_level_metrics": [
      "source_selection_accuracy",
      "coverage",
      "schema_validity",
      "semantic",
      "information_quality",
      "content_fidelity"
    ],
    "dataset_level_metrics": [
      "dataset_metadata_quality"
    ]
  },
  "match_annotations_to_gt": "by_index",
  "task_type": "segmentation",
  "dimension": "3d",
  "format": {
    "description": "标注 JSON 必须包含的顶层块与关键字段（与 evaluate.py 对齐）。",
    "strict_mode": true,
    "top_level_blocks": [
      "record",
      "context",
      "media_geometry",
      "tasks"
    ],
    "record_required": [
      "schema_version",
      "dataset_name",
      "image_path"
    ],
    "context_sample_required": [
      "extra"
    ],
    "sample_required_fields": [
      "modality_primary"
    ],
    "sample_non_missing_fields": [
      "sex",
      "race_ethnicity",
      "site_id"
    ],
    "extra_required_any": [
      "source_file",
      "original_filename",
      "subject_id"
    ],
    "extra_non_missing_fields": [
      "source_file",
      "original_filename",
      "subject_id"
    ],
    "media_required": [
      "task_type",
      "dimension"
    ],
    "task_required_fields": {
      "segmentation": [
        "schema_variant"
      ]
    }
  },
  "content": {
    "description": "信息质量与内容一致性用。expected_extra_keys_mode=all 表示每组都要命中；any 表示任一组命中即可。",
    "expected_dataset_name": "Lumbar_Spine_Segmentation",
    "expected_extra_keys_mode": "all",
    "expected_extra_key_groups": {
      "source": [
        "source_file",
        "original_filename",
        "original_path",
        "source_rel_path",
        "source_relpath"
      ],
      "id_or_label": [
        "subject_id",
        "label_file",
        "mask_file",
        "seg_file"
      ]
    },
    "strict_required_extra_keys": [
      "source_file",
      "original_filename"
    ],
    "strict_dataset_name_match": true,
    "strict_source_require_subject_or_label": false,
    "strict_group_all_keys": true,
    "hard_content_constraints": {
      "leaf_task_expected": "lumbar_vertebrae_and_intervertebral_disc_segmentation",
      "confidence_global_min": 0.0,
      "pixel_spacing_mm_positive": true
    },
    "global_expected_blocks": {
      "record": {
        "schema_version": "1.0.1",
        "dataset_name": "Lumbar_Spine_Segmentation"
      },
      "context_sample": {
        "modality_primary": "MRI"

{
  "schema_version": "1.1",
  "dataset_name": "M3D-RefSeg",
  "description": "M3D-RefSeg 3D 医学指代分割数据集 (BAAI-DCAI)。每例 sXXXX/ 包含 ct.nii.gz、mask.nii.gz 与文本标注 (text.json / text_zh.txt)。任务为根据指代文本对相应区域分割。样本 0-19 以 VLM/random.txt 为准；样本路径既可能指向 ct.nii.gz（原图）也可能指向 mask.nii.gz（金标准），expected_extra 中 source_file 始终对应原图 ct.nii.gz。",
  "expected_count": 20,
  "modality_primary": "CT",
  "metrics": [
    "source_selection_accuracy",
    "coverage",
    "schema_validity",
    "semantic",
    "information_quality",
    "content_fidelity",
    "dataset_metadata_quality"
  ],
  "evaluation_protocol": {
    "instance_level_metrics": [
      "source_selection_accuracy",
      "coverage",
      "schema_validity",
      "semantic",
      "information_quality",
      "content_fidelity"
    ],
    "dataset_level_metrics": [
      "dataset_metadata_quality"
    ]
  },
  "match_annotations_to_gt": "by_index",
  "task_type": "segmentation",
  "dimension": "3d",
  "format": {
    "description": "标注 JSON 必须包含的顶层块与关键字段（和 evaluate.py 对齐）。",
    "strict_mode": true,
    "top_level_blocks": [
      "record",
      "context",
      "media_geometry",
      "tasks"
    ],
    "record_required": [
      "schema_version",
      "dataset_name",
      "image_path"
    ],
    "context_sample_required": [
      "extra"
    ],
    "sample_required_fields": [
      "modality_primary"
    ],
    "sample_non_missing_fields": [
      "sex",
      "race_ethnicity",
      "site_id"
    ],
    "extra_required_any": [
      "source_file",
      "original_filename",
      "subject_id"
    ],
    "extra_non_missing_fields": [
      "source_file",
      "original_filename",
      "subject_id"
    ],
    "media_required": [
      "task_type",
      "dimension"
    ],
    "task_required_fields": {
      "segmentation": [
        "schema_variant"
      ]
    }
  },
  "content": {
    "description": "信息质量与内容一致性用。expected_extra_keys_mode=all 表示每组都要命中；any 表示任一组命中即可。",
    "expected_dataset_name": "M3D-RefSeg",
    "expected_extra_keys_mode": "all",
    "expected_extra_key_groups": {
      "source": [
        "source_file",
        "original_filename",
        "original_path",
        "source_rel_path",
        "source_relpath"
      ],
      "id_or_label": [
        "subject_id",
        "label_file",
        "mask_file",
        "seg_file"
      ]
    },
    "strict_required_extra_keys": [
      "source_file",
      "original_filename"
    ],
    "strict_dataset_name_match": true,
    "strict_source_require_subject_or_label": false,
    "strict_group_all_keys": true,
    "hard_content_constraints": {
      "leaf_task_expected": "referring_expression_segmentation_3d",
      "confidence_global_min": 0.0,
      "pixel_spacing_mm_positive": true
    },
    "global_expected_blocks": {
      "record": {
        "schema_version": "1.0.1",
        "dataset_name": "M3D-RefSeg"
      },
      "context_sample": {
        "modality_primary": "CT"
      },
      "media": {
        "task_type": "segmentation",
        "dimension": "3D"
      },
      "tasks": {
        "segmentation": {
          "schema_variant": "3d_mask"
        }
      }
    }
  },
  "data_meta_expected": {
    "description": "用于评估 Dataset Metadata Quality（数据集级指标）",
    "required_keys": [
      "dataset_name",
      "modality_primary",
      "data_volume",
      "task_type"
    ],
    "optional_but_recommended": [
      "num_classes_per_task",
      "anatomical_structure",
      "domain"
    ],
    "data_volume_required_fields": [
      "total"
    ],
    "strict_equals": {
      "task_type.0": "segmentation",
      "modality_primary.0": "CT",
      "data_volume.total": 20
    }
  },
  "classes": [
    "background",
    "referenced_region"
  ],

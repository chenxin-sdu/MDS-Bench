{
  "schema_version": "1.1",
  "dataset_name": "LUNA16",
  "description": "LUNA16 (Lung Nodule Analysis 2016) 肺结节 3D 检测数据集。annotations.csv 含 (seriesuid, coordX, coordY, coordZ, diameter_mm) 球形结节标注；本目录 random.txt 指向 seg-lungs-LUNA16/ 下的肺野分割 .mhd（与 seriesuid 同名，用作 source / 候选）。约 14/20 例在 annotations.csv 中确实有结节，剩余 6 例为阴性，其 label_text/class_name/bbox_file 置 null。样本 0-19 以 VLM/random.txt 为准。",
  "expected_count": 20,
  "modality_primary": "CT",
  "metrics": [
    "source_selection_accuracy",
    "coverage",
    "schema_validity",
    "semantic",
    "information_quality",
    "content_fidelity",
    "dataset_metadata_quality"
  ],
  "evaluation_protocol": {
    "instance_level_metrics": [
      "source_selection_accuracy",
      "coverage",
      "schema_validity",
      "semantic",
      "information_quality",
      "content_fidelity"
    ],
    "dataset_level_metrics": [
      "dataset_metadata_quality"
    ]
  },
  "match_annotations_to_gt": "by_index",
  "task_type": "detection",
  "dimension": "3d",
  "format": {
    "description": "标注 JSON 必须包含的顶层块与关键字段（和 evaluate.py 对齐）。",
    "strict_mode": true,
    "top_level_blocks": [
      "record",
      "context",
      "media_geometry",
      "tasks"
    ],
    "record_required": [
      "schema_version",
      "dataset_name",
      "image_path"
    ],
    "context_sample_required": [
      "extra"
    ],
    "sample_required_fields": [
      "modality_primary"
    ],
    "sample_non_missing_fields": [
      "sex",
      "race_ethnicity",
      "site_id"
    ],
    "extra_required_any": [
      "source_file",
      "original_filename",
      "subject_id"
    ],
    "extra_non_missing_fields": [
      "source_file",
      "original_filename",
      "subject_id"
    ],
    "media_required": [
      "task_type",
      "dimension"
    ],
    "task_required_fields": {
      "detection": [
        "schema_variant"
      ]
    }
  },
  "content": {
    "description": "信息质量与内容一致性用。expected_extra_keys_mode=all 表示每组都要命中；any 表示任一组命中即可。",
    "expected_dataset_name": "LUNA16",
    "expected_extra_keys_mode": "all",
    "expected_extra_key_groups": {
      "source": [
        "source_file",
        "original_filename",
        "original_path",
        "source_rel_path",
        "source_relpath"
      ],
      "id_or_label": [
        "subject_id",
        "label_text",
        "class_name",
        "bbox_file"
      ]
    },
    "strict_required_extra_keys": [
      "source_file",
      "original_filename"
    ],
    "strict_dataset_name_match": true,
    "strict_source_require_subject_or_label": false,
    "strict_group_all_keys": true,
    "hard_content_constraints": {
      "leaf_task_expected": "lung_nodule_detection",
      "confidence_global_min": 0.0,
      "pixel_spacing_mm_positive": true
    },
    "global_expected_blocks": {
      "record": {
        "schema_version": "1.0.1",
        "dataset_name": "LUNA16"
      },
      "context_sample": {
        "modality_primary": "CT"
      },
      "media": {
        "task_type": "detection",
        "dimension": "3D"
      },
      "tasks": {
        "detection": {
          "schema_variant": "3d"
        }
      }
    }
  },
  "data_meta_expected": {
    "description": "用于评估 Dataset Metadata Quality（数据集级指标）",
    "required_keys": [
      "dataset_name",
      "modality_primary",
      "data_volume",
      "task_type"
    ],
    "optional_but_recommended": [
      "num_classes_per_task",
      "anatomical_structure",
      "domain"
    ],
    "data_volume_required_fields": [
      "total"
    ],
    "strict_equals": {
      "task_type.0": "detection",
      "modality_primary.0": "CT",
      "data_volume.total": 20
    }
  },
  "classes": [
    "nodule"
  ],

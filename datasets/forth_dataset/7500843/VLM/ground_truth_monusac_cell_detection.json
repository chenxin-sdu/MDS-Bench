{
  "schema_version": "1.1",
  "dataset_name": "MoNuSAC-Cell-Detection",
  "description": "Zenodo 7500843 多组织 H&E 显微镜下的细胞检测数据集。每张 .tif 配套同名 .csv（或 _consensus / _raterA/B/C 多版本）提供细胞类别 (Tumor/Lymphocyte/Macrophage/Neutrophil) 与 (XMin,YMin,XMax,YMax) 边界框。文件名前缀 GC=Gastric, NSCLC=Non-small Cell Lung Cancer, TNBC=Triple-Negative Breast Cancer, HNSCC=Head and Neck Squamous Cell Carcinoma。bbox_file 优先指向 <stem>.csv，缺省回退 <stem>_consensus.csv。样本 0-19 以 VLM/random.txt 为准。",
  "expected_count": 20,
  "modality_primary": "Microscopy",
  "metrics": [
    "source_selection_accuracy",
    "coverage",
    "schema_validity",
    "semantic",
    "information_quality",
    "content_fidelity",
    "dataset_metadata_quality"
  ],
  "evaluation_protocol": {
    "instance_level_metrics": [
      "source_selection_accuracy",
      "coverage",
      "schema_validity",
      "semantic",
      "information_quality",
      "content_fidelity"
    ],
    "dataset_level_metrics": [
      "dataset_metadata_quality"
    ]
  },
  "match_annotations_to_gt": "by_index",
  "task_type": "detection",
  "dimension": "2d",
  "format": {
    "description": "标注 JSON 必须包含的顶层块与关键字段（和 evaluate.py 对齐）。",
    "strict_mode": true,
    "top_level_blocks": [
      "record",
      "context",
      "media_geometry",
      "tasks"
    ],
    "record_required": [
      "schema_version",
      "dataset_name",
      "image_path"
    ],
    "context_sample_required": [
      "extra"
    ],
    "sample_required_fields": [
      "modality_primary"
    ],
    "sample_non_missing_fields": [
      "sex",
      "race_ethnicity",
      "site_id"
    ],
    "extra_required_any": [
      "source_file",
      "original_filename",
      "subject_id"
    ],
    "extra_non_missing_fields": [
      "source_file",
      "original_filename",
      "subject_id"
    ],
    "media_required": [
      "task_type",
      "dimension"
    ],
    "task_required_fields": {
      "detection": [
        "schema_variant"
      ]
    }
  },
  "content": {
    "description": "信息质量与内容一致性用。expected_extra_keys_mode=all 表示每组都要命中；any 表示任一组命中即可。",
    "expected_dataset_name": "MoNuSAC-Cell-Detection",
    "expected_extra_keys_mode": "all",
    "expected_extra_key_groups": {
      "source": [
        "source_file",
        "original_filename",
        "original_path",
        "source_rel_path",
        "source_relpath"
      ],
      "id_or_label": [
        "subject_id",
        "label_text",
        "class_name",
        "bbox_file"
      ]
    },
    "strict_required_extra_keys": [
      "source_file",
      "original_filename"
    ],
    "strict_dataset_name_match": true,
    "strict_source_require_subject_or_label": false,
    "strict_group_all_keys": true,
    "hard_content_constraints": {
      "leaf_task_expected": "cell_type_detection_microscopy",
      "confidence_global_min": 0.0,
      "pixel_spacing_mm_positive": true
    },
    "global_expected_blocks": {
      "record": {
        "schema_version": "1.0.1",
        "dataset_name": "MoNuSAC-Cell-Detection"
      },
      "context_sample": {
        "modality_primary": "Microscopy"
      },
      "media": {
        "task_type": "detection",
        "dimension": "2D"
      },
      "tasks": {
        "detection": {
          "schema_variant": "2d"
        }
      }
    }
  },
  "data_meta_expected": {
    "description": "用于评估 Dataset Metadata Quality（数据集级指标）",
    "required_keys": [
      "dataset_name",
      "modality_primary",
      "data_volume",
      "task_type"
    ],
    "optional_but_recommended": [
      "num_classes_per_task",
      "anatomical_structure",
      "domain"
    ],
    "data_volume_required_fields": [
      "total"
    ],
    "strict_equals": {
      "task_type.0": "detection",
      "modality_primary.0": "Microscopy",
      "data_volume.total": 20
    }
  },
  "classes": [
    "Tumor cell",
    "Lymphocyte",
    "Macrophage",
    "Neutrophil"
  ],
